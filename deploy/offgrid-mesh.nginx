server {
    listen 80;
    server_name offgrid.mdfahimhossen.space;

    root /opt/offgrid-mesh/web;
    index index.html;

    # Her node API + events (the browser client talks to its own node here)
    location /api/ {
        proxy_pass http://127.0.0.1:18081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location /ws {
        proxy_pass http://127.0.0.1:18081;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    # Tunnel gateway passthrough to her node
    location /tunnel/ {
        proxy_pass http://127.0.0.1:18081;
        proxy_set_header Host $host;
    }

    # Hub sync endpoint for other nodes: /hub/api/... -> hub node /api/...
    location /hub/ {
        proxy_pass http://127.0.0.1:18090/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
